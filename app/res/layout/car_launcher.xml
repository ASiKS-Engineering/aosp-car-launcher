<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@android:color/transparent"
    tools:context=".CarLauncher">

<androidx.constraintlayout.widget.ConstraintLayout ... android:background="@android:color/transparent">

    <!-- Die Karte im Hintergrund -->
    <androidx.cardview.widget.CardView
        android:id="@+id/maps_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <FrameLayout android:id="@+id/maps_card_container" android:layout_width="match_parent" android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <!-- Hilfslinie bei 33% (1/3 des Bildschirms) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/vertical_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33" />

    <!-- NUR das Audio-Widget links oben -->
    <com.android.car.ui.FocusArea
        android:id="@+id/bottom_card"
        android:layout_width="0dp"
        android:layout_height="200dp" 
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/vertical_guideline"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp" />

    <!--com.android.car.ui.FocusParkingView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/-->

</androidx.constraintlayout.widget.ConstraintLayout>
